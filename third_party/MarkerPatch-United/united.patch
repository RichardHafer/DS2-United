 	IncreasedEntityPersistenceBodies = std::clamp(IncreasedEntityPersistenceBodies, 0, 35);
 	IncreasedEntityPersistenceLimbs = std::clamp(IncreasedEntityPersistenceLimbs, 0, 120);
 
+	// Dead Space 2 United edition: the same MarkerPatch.ini, but these stay off whatever it says.
+	// FixSuitChangeTiming and MultiplayerSuit hook the suit functions United's partner suits and
+	// loadouts are built on; AlwaysSucceedQTE answers prompts the scene leader decides in co-op;
+	// FixMainLoopSpin, FixAudioSyncStall and FixStreamingBudget retime the main loop, the clock
+	// and the spawner while United paces its own work on them (suspects in the hang of two copies
+	// on one PC). United is an ASI plugin, so the loader always runs.
+	FixSuitChangeTiming = false;
+	MultiplayerSuit = 0;
+	AlwaysSucceedQTE = false;
+	FixMainLoopSpin = false;
+	FixAudioSyncStall = false;
+	FixStreamingBudget = false;
+	LoadASIPlugins = true;
+
 	// Init SDL variables
 	ControllerHelper::SetGyroEnabled(GyroEnabled);
 	ControllerHelper::SetGyroSensitivity(GyroSensitivity);
