@@ -270,6 +271,18 @@ namespace IniHelper
 
 	void Init()
 	{
+		// Dead Space 2 United edition: a missing MarkerPatch.ini is written with the defaults first.
+		const std::string path = SystemHelper::GetModulePath() + "\\MarkerPatch.ini";
+		if (GetFileAttributesA(path.c_str()) == INVALID_FILE_ATTRIBUTES)
+		{
+			HANDLE file = CreateFileA(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+			if (file != INVALID_HANDLE_VALUE)
+			{
+				DWORD written = 0;
+				WriteFile(file, kUnitedDefaultIni, static_cast<DWORD>(sizeof(kUnitedDefaultIni)), &written, nullptr);
+				CloseHandle(file);
+			}
+		}
 		iniFile.read(iniReader);
 	}
 
