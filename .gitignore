/for_mark/
/share/
/coop_launchers/
*.rar
*.zip

# Runtime leftovers
*.log
*.bak*
*.previous
*.tmp
*.before_*

# Game-derived pictures and sounds
/arenas/pictures/
/tools/loadout_photos/
/voices/_example_pack/**/*.wav
/tools/package_friends.py
/assets/CoopMod_Logo.png
